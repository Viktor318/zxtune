msgid "ALSA sound system backend"
msgstr "ALSA hangrendszer-kimenet"

msgid "Error in ALSA backend: {}."
msgstr "Hiba az ALSA kimenetben: {}."

msgid "Error in ALSA backend while working with device '{0}': {1}."
msgstr "Hiba az ALSA kimenetben ('{0}' eszköz): {1}."

msgid "No suitable formats supported by ALSA."
msgstr "Az ALSA egyetlen megfelelő formátumot sem támogat."

msgid "Failed to found mixer '{}' for ALSA backend."
msgstr "Az ALSA kimenethez nem található keverő: '{}'."

msgid "Failed to set volume: gain is out of range."
msgstr ""
"A hangerő nem állítható be: az erősítés a megengedett tartományon kívül esik."

msgid "ALSA backend error: latency ({0}) is out of range ({1}..{2})."
msgstr ""
"Hiba az ALSA kimenetben: a késleltetés ({0}) a megengedett tartományon kívül "
"esik ({1}..{2})."

msgid "No suitable output devices found"
msgstr "Nincs megfelelő kimeneti eszköz"

msgid "Real AY via LPT backend"
msgstr "Valódi AY chip LPT porton"

msgid "Real AY via LPT is not supported for this module."
msgstr "Ehhez a modulhoz nem használható a valódi AY chip LPT porton."

msgid "Failed to initialize playback."
msgstr "A lejátszás előkészítése nem sikerült."

msgid "Failed to finalize playback."
msgstr "A lejátszás lezárása nem sikerült."

msgid "Failed to pause playback."
msgstr "A lejátszás nem szüneteltethető."

msgid "Failed to resume playback."
msgstr "A lejátszás nem folytatható."

msgid "Failed to stop playback."
msgstr "A lejátszás nem állítható le."

msgid "Failed to set playback position."
msgstr "A lejátszási pozíció nem állítható be."

